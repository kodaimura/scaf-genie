# Database
JULIA_VERSION=1.12.6
POSTGRES_VERSION=17.10
POSTGRES_DB=project_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/project_db?sslmode=disable

# App
API_BIND_HOST=127.0.0.1
API_PORT=8000
APP_ENV=dev
GENIE_ENV=dev
LOG_LEVEL=INFO
ENABLE_SIGNUP=true
AUTH_LOGIN_ID_MODE=email
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Jwt
ACCESS_TOKEN_SECRET=change-me-access-token-secret
ACCESS_TOKEN_EXPIRES_SECONDS=900
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret
REFRESH_TOKEN_EXPIRES_SECONDS=43200
REFRESH_TOKEN_REMEMBER_ME_EXPIRES_SECONDS=2592000

# Password reset
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
PASSWORD_RESET_RESEND_INTERVAL_MINUTES=5

# Mail
MAILHOG_BIND_HOST=127.0.0.1
MAIL_PROVIDER=mailhog
MAIL_FROM=no-reply@example.local
# SMTP_HOST=mailhog
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false

# MAIL_PROVIDER=smtp
# MAIL_FROM=no-reply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# Production example:
# APP_ENV=production
# GENIE_ENV=prod
# API_BIND_HOST=127.0.0.1
# DATABASE_URL=postgresql://postgres:change-me-db-password@db.example.com:5432/project_db?sslmode=require
# FRONTEND_ORIGINS=https://example.com
# PASSWORD_RESET_URL_BASE=https://example.com/reset-password
